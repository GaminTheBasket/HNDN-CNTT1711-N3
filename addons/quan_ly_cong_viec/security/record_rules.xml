<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_task_simple" model="ir.rule">
            <field name="name">Simple Task Rule</field>
            <field name="model_id" ref="model_cong_viec"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('quan_ly_du_an.group_game_user'))]"/>
        </record>

        <record id="rule_task_all_manager" model="ir.rule">
            <field name="name">All Tasks Manager</field>
            <field name="model_id" ref="model_cong_viec"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('quan_ly_du_an.group_game_hr'))]"/>
        </record>
    </data>
</odoo>