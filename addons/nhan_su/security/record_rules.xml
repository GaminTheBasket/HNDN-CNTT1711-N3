<odoo>
    <data noupdate="0">
        <record id="rule_visibility_staff_only" model="ir.rule">
            <field name="name">Ẩn Sếp khỏi danh sách thường</field>
            <field name="model_id" ref="model_nhan_vien"/>
            <field name="domain_force">
                ['|', ('vai_tro', 'in', ['3d_artist', '2d_artist', 'dev', 'designer', 'qa']), ('user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('nhan_su.group_nhan_su_manager'))]"/>
        </record>

        <record id="rule_admin_unlimited" model="ir.rule">
            <field name="name">Admin: Thấy hết</field>
            <field name="model_id" ref="model_nhan_vien"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>