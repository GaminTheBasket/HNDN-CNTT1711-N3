<odoo>
    <data noupdate="0">
        <record id="rule_staff_cannot_see_boss" model="ir.rule">
            <field name="name">Nhân viên: Không thấy HR/Manager</field>
            <field name="model_id" ref="model_nhan_vien"/>
            <field name="domain_force">['|', ('vai_tro', 'not in', ['hr', 'manager']), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_admin_see_all" model="ir.rule">
            <field name="name">Admin: Thấy toàn bộ nhân viên</field>
            <field name="model_id" ref="model_nhan_vien"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>