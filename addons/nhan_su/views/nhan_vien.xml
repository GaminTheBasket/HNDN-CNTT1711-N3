<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_nhan_vien_form" model="ir.ui.view">
            <field name="name">nhan_vien.form</field>
            <field name="model">nhan_vien</field>
            <field name="arch" type="xml">
                <form>
                    <header><field name="trang_thai_lam_viec" widget="statusbar" options="{'clickable': '1'}"/></header>
                    <sheet>
                        <field name="anh" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1><field name="ho_va_ten" readonly="1" force_save="1"/></h1>
                            <h3><field name="ma_dinh_danh" readonly="1" force_save="1"/></h3>
                        </div>
                        <group>
                            <group string="Thông tin cá nhân">
                                <field name="ho_ten_dem"/><field name="ten"/>
                                <field name="ngay_sinh"/><field name="tuoi" readonly="1" force_save="1"/>
                                <field name="user_id" groups="base.group_system"/>
                            </group>
                            <group string="Thông tin công tác">
                                <field name="vai_tro" groups="base.group_system"/>
                                <field name="vai_tro" groups="!base.group_system" readonly="1" force_save="1"/>
                                <field name="phong_ban"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_nhan_vien_tree" model="ir.ui.view">
            <field name="name">nhan_vien.tree</field>
            <field name="model">nhan_vien</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="ma_dinh_danh"/>
                    <field name="ho_va_ten"/>
                    <field name="vai_tro"/>
                    <field name="phong_ban"/>
                    <field name="trang_thai_lam_viec" widget="badge"/>
                </tree>
            </field>
        </record>

        <record id="action_nhan_vien" model="ir.actions.act_window">
            <field name="name">Nhân viên</field>
            <field name="res_model">nhan_vien</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>